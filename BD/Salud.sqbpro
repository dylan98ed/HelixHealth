values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Prescripciones" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="33"/><column index="2" value="87"/><column index="3" value="104"/><column index="4" value="85"/><column index="5" value="83"/><column index="6" value="42"/><column index="7" value="133"/><column index="8" value="77"/><column index="9" value="65"/><column index="10" value="65"/><column index="11" value="89"/><column index="12" value="132"/><column index="13" value="87"/><column index="14" value="70"/><column index="15" value="48"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Profesionales" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="29"/><column index="2" value="70"/><column index="3" value="51"/><column index="4" value="70"/><column index="5" value="107"/><column index="6" value="34"/><column index="7" value="70"/><column index="8" value="96"/><column index="9" value="70"/><column index="10" value="179"/><column index="11" value="156"/><column index="12" value="42"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- ================================================================
-- TABLA DE USUARIOS - OPENHIS-UNLaM
-- Sistema de Seguridad y Autenticación
-- ================================================================
-- 
-- ESTRUCTURA:
--   - id: Identificador único
--   - usuario: Nombre de usuario (único)
--   - password_hash: Contraseña hasheada con SHA-256
--   - nombre_completo: Nombre y apellido
--   - email: Correo electrónico
--   - rol: admin | medico | enfermero | administrativo
--   - activo: 1=Activo, 0=Inactivo (borrado lógico)
--   - ultimo_acceso: Última vez que inició sesión
--   - fecha_creacion: Fecha de alta
--
-- ROLES Y PERMISOS:
--   admin:          Acceso total a todos los módulos
--   medico:         Pacientes, Signos Vitales, Prescripciones, HCE
--   enfermero:      Pacientes, Signos Vitales, HCE
--   administrativo: Pacientes, Profesionales, Turnos
-- ================================================================

-- Crear tabla de usuarios
CREATE TABLE IF NOT EXISTS Usuarios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    usuario TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    nombre_completo TEXT NOT NULL,
    email TEXT,
    rol TEXT NOT NULL CHECK (rol IN ('admin', 'medico', 'enfermero', 'administrativo')),
    activo INTEGER DEFAULT 1,
    ultimo_acceso TIMESTAMP,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Crear índices para búsquedas rápidas
CREATE INDEX IF NOT EXISTS idx_usuarios_usuario ON Usuarios(usuario);
CREATE INDEX IF NOT EXISTS idx_usuarios_rol ON Usuarios(rol);
CREATE INDEX IF NOT EXISTS idx_usuarios_activo ON Usuarios(activo);

-- ================================================================
-- USUARIOS DE PRUEBA
-- ================================================================
-- Las contraseñas están hasheadas con SHA-256:
--
--   admin      / admin123      → 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
--   medico     / medico123     → 5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8
--   enfermero  / enfermero123  → (ver script Python para generar)
--   admin2     / admin123      → 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
--
-- IMPORTANTE: Los hashes se generan desde Python con:
--   import hashlib
--   hashlib.sha256(&quot;admin123&quot;.encode('utf-8')).hexdigest()
-- ================================================================

INSERT OR IGNORE INTO Usuarios 
    (usuario, password_hash, nombre_completo, email, rol, activo) 
VALUES 
    ('admin', 
     '240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9',
     'Administrador del Sistema', 
     'admin@hospital.com', 
     'admin', 
     1),
    
    ('medico', 
     '5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8',
     'Dr. Juan Médico', 
     'medico@hospital.com', 
     'medico', 
     1),
    
    ('enfermero', 
     '5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8',
     'Enf. María Enfermera', 
     'enfermero@hospital.com', 
     'enfermero', 
     1),
    
    ('admin2', 
     '240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9',
     'Segundo Administrador', 
     'admin2@hospital.com', 
     'admin', 
     1),
    
    ('admin3', 
     '240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9',
     'Administrador Inactivo', 
     'admin3@hospital.com', 
     'admin', 
     0);

-- ================================================================
-- VERIFICACIÓN
-- ================================================================

SELECT '=== USUARIOS CREADOS ===' as '';
SELECT id, usuario, nombre_completo, rol, activo 
FROM Usuarios 
ORDER BY id;

SELECT '=== TOTAL ===' as '';
SELECT COUNT(*) as Total, SUM(activo) as Activos FROM Usuarios;
</sql><sql name="SQL 3*">-- ================================================================
-- CREACIÓN DE LA TABLA DE AUDITORÍA - OPENHIS-UNLaM
-- ================================================================
-- 
-- Esta tabla guarda TODAS las acciones de los usuarios en el sistema.
-- 
-- TIPOS DE ACCIÓN:
--   A = Alta (creación local)
--   M = Modificación
--   B = Baja lógica
--   R = Reactivación
--   L = Login
--   X = Logout
--   E = Exportación (datos enviados a otro sistema - FHIR)
--   I = Importación (datos recibidos de otro sistema - FHIR)
--   C = Conflicto (importación con problema)
--
-- CAMPOS PARA INTERCAMBIO FHIR:
--   origen_sistema      → Nombre del hospital/sistema externo
--   origen_id_externo   → ID del registro en el sistema externo
--   payload_referencia  → Ruta al archivo XML/JSON intercambiado
--
-- EJECUTAR EN: DB Browser for SQLite → BD/Salud.db → Ejecutar SQL
-- ================================================================

-- ================================================================
-- 1. CREAR LA TABLA
-- ================================================================

CREATE TABLE IF NOT EXISTS Auditoria (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    usuario_id INTEGER NOT NULL,
    usuario_nombre TEXT,
    tabla_afectada TEXT NOT NULL,
    registro_id INTEGER,
    tipo_accion TEXT NOT NULL CHECK (tipo_accion IN ('A', 'M', 'B', 'R', 'L', 'X', 'E', 'I', 'C')),
    descripcion TEXT,
    datos_anteriores TEXT,
    datos_nuevos TEXT,
    fecha_hora TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    origen_sistema TEXT,
    origen_id_externo TEXT,
    payload_referencia TEXT,
    FOREIGN KEY (usuario_id) REFERENCES Usuarios(id)
);


-- ================================================================
-- 2. CREAR ÍNDICES
-- ================================================================

-- Índice por usuario (para &quot;ver todo lo que hizo el usuario X&quot;)
CREATE INDEX IF NOT EXISTS idx_auditoria_usuario 
    ON Auditoria(usuario_id);

-- Índice por tabla (para &quot;ver todo lo que pasó en Pacientes&quot;)
CREATE INDEX IF NOT EXISTS idx_auditoria_tabla 
    ON Auditoria(tabla_afectada);

-- Índice por fecha (para &quot;ver qué pasó hoy&quot;, &quot;última semana&quot;, etc.)
CREATE INDEX IF NOT EXISTS idx_auditoria_fecha 
    ON Auditoria(fecha_hora);

-- Índice por tipo de acción (para &quot;ver todas las importaciones&quot;)
CREATE INDEX IF NOT EXISTS idx_auditoria_tipo 
    ON Auditoria(tipo_accion);

-- Índice compuesto (para &quot;ver el historial del registro X en la tabla Y&quot;)
CREATE INDEX IF NOT EXISTS idx_auditoria_registro 
    ON Auditoria(tabla_afectada, registro_id);

-- Índice por hospital de origen (para &quot;ver todo el intercambio con Fleming&quot;)
CREATE INDEX IF NOT EXISTS idx_auditoria_origen 
    ON Auditoria(origen_sistema);

-- Índice por ID externo (para &quot;buscar un registro por su ID en el otro hospital&quot;)
CREATE INDEX IF NOT EXISTS idx_auditoria_externo 
    ON Auditoria(origen_id_externo);


-- ================================================================
-- 3. VERIFICACIÓN
-- ================================================================

SELECT '=== ESTRUCTURA DE LA TABLA ===' as '';
PRAGMA table_info(Auditoria);


SELECT '=== ÍNDICES CREADOS ===' as '';
SELECT name as 'Índice', tbl_name as 'Tabla'
FROM sqlite_master 
WHERE type='index' 
AND name LIKE 'idx_auditoria%'
ORDER BY name;


SELECT '=== ESTADO INICIAL ===' as '';
SELECT COUNT(*) as 'Total registros en Auditoria' FROM Auditoria;


SELECT '=== TIPOS DE ACCIÓN ===' as '';
SELECT 
    'A' as 'Tipo', 'Alta' as 'Descripción'
UNION ALL SELECT 'M', 'Modificación'
UNION ALL SELECT 'B', 'Baja'
UNION ALL SELECT 'R', 'Reactivación'
UNION ALL SELECT 'L', 'Login'
UNION ALL SELECT 'X', 'Logout'
UNION ALL SELECT 'E', 'Exportación (FHIR)'
UNION ALL SELECT 'I', 'Importación (FHIR)'
UNION ALL SELECT 'C', 'Conflicto';


SELECT '=== FIN DEL SCRIPT ===' as '';
</sql><current_tab id="1"/></tab_sql></sqlb_project>
